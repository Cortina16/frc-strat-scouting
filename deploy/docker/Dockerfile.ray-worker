# Multi-Stage Dockerfile for Ray Worker Nodes (Heterogeneous Supercluster: RTX 4090 GPU & CPU)
# ==============================================================================
# Architecture: FRC 2026 REBUILT Automated Video Scouting Supercluster
# Targets: CUDA 12.4 Runtime, TensorRT 10.3, PyTorch 2.4, Ray Core 2.58 / 2.38,
#          OpenCV Headless, DuckDB OLAP Engine, FFmpeg/PyAV Ingestion.
# Shared Memory: Requires /dev/shm mount backed by RAM (emptyDir: medium: Memory)
# ==============================================================================

# ==============================================================================
# Stage 1: Build & Python Dependency Pre-Compilation
# ==============================================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

# Performance & non-interactive build environment
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    RAY_DISABLE_IMPORT_WARNING=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install toolchain and Python 3.10 / 3.12 development prerequisites
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    ca-certificates \
    pkg-config \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Establish hermetic virtual environment for Python packages
RUN python3.10 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade base packaging tools
RUN pip install --upgrade pip setuptools wheel

# Install PyTorch with native CUDA 12.4 acceleration
RUN pip install --no-cache-dir \
    torch==2.4.1 torchvision==0.19.1 --index-url https://download.pytorch.org/whl/cu124

# Install TensorRT 10.3, Ray Core 2.58 (with compatible range 2.38.0 - 2.58.0), OpenCV Headless, and DuckDB
RUN pip install --no-cache-dir \
    tensorrt==10.3.0 \
    "ray[default]>=2.38.0,<=2.58.0" \
    opencv-python-headless==4.10.0.84 \
    duckdb==1.1.3 \
    paho-mqtt==2.1.0 \
    protobuf==5.28.3 \
    numpy==1.26.4 \
    scipy==1.13.1 \
    av==13.0.0 \
    pydantic==2.9.2 \
    pyyaml==6.0.2

# ==============================================================================
# Stage 2: Minimal Production Runtime
# ==============================================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS runtime

LABEL maintainer="FRC Scouting Architecture Team" \
      description="Ray Worker supercluster image with CUDA 12.4 runtime, TensorRT 10.3, PyTorch, Ray Core 2.58, OpenCV, and DuckDB"

# Core performance & telemetry environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    RAY_DISABLE_IMPORT_WARNING=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    PATH="/opt/venv/bin:/usr/local/cuda/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}" \
    RAY_HEAD_ADDRESS=""

# Install essential shared runtime libraries (FFmpeg decoding, OpenCV dependencies, process monitoring)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-venv \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    ca-certificates \
    procps \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv

# Configure working directory
WORKDIR /app

# Copy application modules and schemas
COPY proto /app/proto
COPY src /app/src
COPY configs /app/configs
COPY deploy/docker/entrypoint-ray-worker.sh /usr/local/bin/entrypoint-ray-worker.sh

RUN chmod +x /usr/local/bin/entrypoint-ray-worker.sh

# High-throughput Plasma object store requirement:
# Worker pods must mount /dev/shm with memory-backed volume (emptyDir: medium: Memory)
# to guarantee zero-copy IPC throughput without swap thrashing at 60-120 FPS.

ENTRYPOINT ["/usr/local/bin/entrypoint-ray-worker.sh"]
CMD ["--block"]
